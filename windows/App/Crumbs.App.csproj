<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(CrumbsTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Crumbs</AssemblyName>
    <RootNamespace>Crumbs</RootNamespace>
    <ApplicationIcon>crumbs.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Product>Crumbs</Product>
    <Description>Uninstall programs. Completely.</Description>
    <Copyright>MIT License</Copyright>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Crumbs.Core.csproj" />
    <Resource Include="crumbs.ico" />
  </ItemGroup>
</Project>

<Window x:Class="Crumbs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crumbs" Width="1040" Height="680" MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="crumbs.ico"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave" KeyDown="OnKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Home, search and your programs -->
        <DockPanel Grid.Column="0" Margin="12,12,6,12">
            <Grid DockPanel.Dock="Top">
                <TextBox x:Name="Search" TextChanged="OnSearch" Padding="8,6" ToolTip="Search programs"/>
                <TextBlock Text="Search programs" Opacity="0.5" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           x:Name="SearchHint"/>
            </Grid>
            <Button x:Name="HomeButton" DockPanel.Dock="Top" Click="OnHome" Margin="0,10,0,0" HorizontalContentAlignment="Left" Padding="10,6">
                <TextBlock Text="🏠  Home"/>
            </Button>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Click="OnCheckUpdates" HorizontalContentAlignment="Left" Padding="10,5" Margin="0,2">
                    <TextBlock Text="🔄  Check for updates"/>
                </Button>
                <Button Click="OnReportProblem" HorizontalContentAlignment="Left" Padding="10,5" Margin="0,2">
                    <TextBlock Text="🐞  Report a problem"/>
                </Button>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="Programs" Opacity="0.6" Margin="6,14,0,4" FontWeight="SemiBold"/>
            <ListBox x:Name="AppList" SelectionChanged="OnSelectApp" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Publisher}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="🔒" Opacity="0.6" Visibility="{Binding LockVisibility}" ToolTip="Windows or Microsoft program: protected"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Main area -->
        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Update banner -->
            <Border x:Name="UpdateBanner" Visibility="Collapsed" CornerRadius="12" Padding="14,10" Margin="0,0,0,10"
                    Background="#1A2F6FEB">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="What's new" Click="OnWhatsNew" Margin="4,0" Padding="12,4"/>
                        <Button Content="Later" Click="OnLater" Margin="4,0" Padding="12,4"/>
                        <Button x:Name="UpdateNowButton" Content="Update now" Click="OnUpdateNow" Margin="4,0" Padding="12,4"
                                Style="{DynamicResource AccentButtonStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Text="✨  A new version of Crumbs is ready."/>
                </DockPanel>
            </Border>

            <!-- Welcome screen -->
            <Border x:Name="Welcome" Grid.Row="1" CornerRadius="24" Padding="48,40" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#0D7F7F7F" BorderBrush="#337F7F7F" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="DoneNotice" Visibility="Collapsed" CornerRadius="14" Padding="14,6" Margin="0,0,0,16" Background="#2622A55A"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="DoneText" Foreground="{StaticResource SureBrush}"/>
                    </Border>
                    <TextBlock x:Name="WelcomeIcon" Text="✨" FontSize="44" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="WelcomeTitle" Text="Welcome to Crumbs" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                    <TextBlock Text="Pick a program on the left, or drop its shortcut here.&#x0a;Crumbs uninstalls it and shows what it left behind. You choose what goes."
                               TextAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="460"/>
                </StackPanel>
            </Border>

            <!-- One program -->
            <Grid x:Name="Detail" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="8,4,8,12">
                    <Image x:Name="DetailIcon" Width="48" Height="48" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="DetailName" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DetailSub" Opacity="0.65"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" x:Name="MessagePanel" CornerRadius="12" Padding="14,10" Margin="0,0,0,8" Background="#142F6FEB" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.Row="2">
                    <ListView x:Name="LeftoverList" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Where}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="9" Padding="8,1" Margin="4,0" Background="#26A23BD1" Visibility="{Binding DataVisibility}"
                                                ToolTip="This folder may hold your own settings or files for this program.">
                                            <TextBlock Text="Your data" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}"/>
                                        </Border>
                                        <Border CornerRadius="9" Padding="8,1" Margin="4,0" Background="#267A7A7A" Visibility="{Binding AdminVisibility}"
                                                ToolTip="Needs administrator rights to remove.">
                                            <TextBlock Text="Admin" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AdminBrush}"/>
                                        </Border>
                                        <Border CornerRadius="9" Padding="8,1" Margin="4,0" Background="{Binding LabelBackground}" ToolTip="{Binding LabelTip}">
                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LabelBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="Scanning" Text="Looking…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" Visibility="Collapsed"/>
                </Grid>

                <!-- Bottom bar -->
                <Border Grid.Row="3" CornerRadius="18" Padding="14,10" Margin="0,10,0,0" Background="#0F7F7F7F" BorderBrush="#227F7F7F" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="UndoButton" Content="Undo" Click="OnUndo" Margin="4,0" Padding="14,6" Visibility="Collapsed"/>
                            <Button x:Name="AdminButton" Content="Restart as administrator" Click="OnRestartAdmin" Margin="4,0" Padding="14,6" Visibility="Collapsed"/>
                            <Button x:Name="UninstallButton" Click="OnUninstall" Margin="4,0" Padding="16,6" Style="{DynamicResource AccentButtonStyle}"/>
                            <Button x:Name="CleanButton" Click="OnClean" Margin="4,0" Padding="16,6"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Opacity="0.7"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Shown while dragging something over the window -->
            <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" CornerRadius="24" Background="#332F6FEB"
                    BorderBrush="#2F6FEB" BorderThickness="2" IsHitTestVisible="False">
                <TextBlock Text="Drop to find this program" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
